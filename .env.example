# x-poster-cli (xbot) config. Copy to ~/.config/xbot/env and `chmod 600` it.
# KEY=VALUE, one per line. Real environment variables override these.
# NEVER commit or share this file once it has real values.

# Optional: Grok drafting via the xAI API (https://console.x.ai)
XAI_API_KEY=
# Where to send xAI requests. Default in code is a local proxy (http://127.0.0.1:8767/v1).
# Most users want the direct API:
XBOT_BASE_URL=https://api.x.ai/v1
# XBOT_MODEL=grok-4.7

# X API, OAuth 1.0a user context (app needs Read and Write). https://developer.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: OAuth 2.0 (PKCE) for likes via `xbot login`. Client ID from your X app (Keys and tokens > OAuth 2.0).
X_CLIENT_ID=
# Only for a confidential (Web App) client:
# X_CLIENT_SECRET=
